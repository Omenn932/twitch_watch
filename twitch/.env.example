# Copy this file to twitch/.env and fill it in. Never commit .env.

# From https://twitchtokengenerator.com (Bot Chat Token, scopes chat:read + chat:edit).
# Paste BOTH the access token and the refresh token.
TWITCH_ACCESS_TOKEN=replace_with_access_token
TWITCH_REFRESH_TOKEN=replace_with_refresh_token
TWITCH_CLIENT_ID=replace_with_client_id

# Optional: only if you use your own app from dev.twitch.tv instead of
# twitchtokengenerator. With a secret set, refreshes go straight to Twitch.
# TWITCH_CLIENT_SECRET=

TWITCH_BOT_NICK=Omenn932
TWITCH_CHANNEL=mad_matty_
TWITCH_TANGIA_CHANNELS=comradespacegod,suparticus,hobbitide
